#!/usr/bin/env python3
"""Quality gate: decision-record numbers are unique.

Why this is worth a script. Two people write a decision on the same day, each on
their own branch, and both take the next free number. Each pull request is fine
on its own; merged together, "0007" means two different decisions, and every
later reference to it is ambiguous. Run on the merged result — in the pipeline of
the second pull request — this fails before that happens.

Checks `docs/decisions/NNNN-*.md`:

1. DUPLICATE NUMBER — two records share a number.
2. BAD NAME — a record not named `NNNN-kebab-title.md` (four digits).

Exit code 0 = clean, 1 = violations found.

Usage:
    python3 scripts/check_decisions.py
"""

import re
import sys
from collections import defaultdict
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
DECISIONS = REPO_ROOT / "docs" / "decisions"
NAME_RE = re.compile(r"(\d{4})-[a-z0-9]+(-[a-z0-9]+)*\.md")


def main():
    if not DECISIONS.is_dir():
        print(f"FAIL: {DECISIONS.relative_to(REPO_ROOT)} does not exist")
        return 1
    by_number, problems = defaultdict(list), []
    for f in sorted(DECISIONS.glob("*.md")):
        if f.name == "README.md":
            continue
        m = NAME_RE.fullmatch(f.name)
        if not m:
            problems.append(f"docs/decisions/{f.name}: BAD NAME — expected NNNN-kebab-title.md")
            continue
        by_number[m.group(1)].append(f.name)
    for number, names in sorted(by_number.items()):
        if len(names) > 1:
            problems.append(f"docs/decisions: DUPLICATE NUMBER {number} — {', '.join(names)}; "
                            "renumber the newer record and its index row")
    for p in problems:
        print(p)
    print(f"{len(problems)} problem(s) in {sum(map(len, by_number.values()))} record(s)"
          if problems else f"OK: {sum(map(len, by_number.values()))} record(s), numbers unique")
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())
