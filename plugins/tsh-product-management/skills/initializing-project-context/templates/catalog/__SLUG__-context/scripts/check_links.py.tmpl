#!/usr/bin/env python3
"""Quality gate: every relative markdown link resolves, every filename is kebab-case.

Why this is worth a script. A knowledge base is one large reference tree, and a
link breaks silently: renaming or deleting one file breaks links in files nobody
touched. The whole corpus is checked, not only changed files, for that reason.

Two checks over every markdown file in the repository:

1. LINKS — every relative `[text](target)` must point at a file or folder that is
   part of the corpus. Inside a git repository the corpus is the set of TRACKED
   files, because a link that resolves on your disk but was never committed is
   already broken for everyone else. Outside git it is the working tree minus
   ignored folders. External links (http, mailto) and bare `#anchor` links are
   skipped. A link that resolves outside the repository is treated as a citation
   and skipped too.

2. NAMING — markdown filenames must be kebab-case. Allowed: kebab-case with
   optional dotted suffixes (`release-plan.draft.md`), a structural underscore
   prefix (`_template.md`), zero-padded decision records (`0001-title.md`), and
   the well-known uppercase files README, CLAUDE, SKILL, GUIDE, CHANGELOG.

Exit code 0 = clean, 1 = violations found.

Usage:
    python3 scripts/check_links.py            # full check
    python3 scripts/check_links.py FILE...    # link-check only these files
"""

import re
import subprocess
import sys
import urllib.parse
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
IGNORED_DIRS = {".git", "node_modules", ".idea", ".vscode", ".claude"}

LINK_RE = re.compile(
    r"\[[^\]]*\]\(\s*(?:<([^<>]+)>|([^()<>\s]+(?:\([^()]*\)[^()\s]*)*))\s*\)")
SKIP_SCHEMES = ("http://", "https://", "mailto:", "tel:", "file:")

KEBAB = r"[a-z0-9]+(-[a-z0-9]+)*"
NAME_PATTERNS = [
    re.compile(rf"^{KEBAB}(\.{KEBAB})*\.md$"),
    re.compile(rf"^_{KEBAB}\.md$"),
    re.compile(r"^\d\d\d+-" + KEBAB + r"\.md$"),
    re.compile(r"^(README|CLAUDE|SKILL|GUIDE|CHANGELOG)\.md$"),
]


def tracked_by_git():
    """Return the set of git-tracked paths, or None when this is not a git repository."""
    try:
        probe = subprocess.run(["git", "rev-parse", "--is-inside-work-tree"],
                               cwd=REPO_ROOT, capture_output=True, text=True)
        if probe.returncode != 0 or probe.stdout.strip() != "true":
            return None
        out = subprocess.run(["git", "-c", "core.quotepath=off", "ls-files", "-z"],
                             cwd=REPO_ROOT, capture_output=True, text=True,
                             check=True).stdout
        return {p for p in out.split("\0") if p}
    except (FileNotFoundError, subprocess.CalledProcessError):
        return None


def corpus():
    """Return (files, dirs) as repository-relative POSIX strings."""
    files = tracked_by_git()
    if files is None:
        files = set()
        for path in REPO_ROOT.rglob("*"):
            rel = path.relative_to(REPO_ROOT)
            if any(part in IGNORED_DIRS for part in rel.parts):
                continue
            if path.is_file():
                files.add(rel.as_posix())
    dirs = set()
    for f in files:
        for parent in Path(f).parents:
            if str(parent) != ".":
                dirs.add(parent.as_posix())
    return files, dirs


def links_in(md_path):
    """Yield (line number, raw target), skipping fenced code blocks."""
    in_fence = False
    for lineno, line in enumerate(
            md_path.read_text(encoding="utf-8", errors="replace").splitlines(), 1):
        stripped = line.lstrip()
        if stripped.startswith("```") or stripped.startswith("~~~"):
            in_fence = not in_fence
            continue
        if in_fence:
            continue
        for match in LINK_RE.finditer(line):
            yield lineno, match.group(1) or match.group(2)


def classify(md_path, raw):
    """Return (kind, resolved path or None): external, anchor, citation or internal."""
    if raw.startswith(SKIP_SCHEMES):
        return "external", None
    if raw.startswith("#"):
        return "anchor", None
    target = urllib.parse.unquote(raw.split("#", 1)[0])
    if not target:
        return "anchor", None
    resolved = (md_path.parent / target).resolve()
    try:
        resolved.relative_to(REPO_ROOT)
    except ValueError:
        return "citation", resolved
    return "internal", resolved


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("-")]
    files, dirs = corpus()
    all_md = sorted(f for f in files if f.endswith(".md"))
    targets = ([Path(a).resolve() for a in args] if args
               else [REPO_ROOT / f for f in all_md])
    targets = [t for t in targets if t.suffix == ".md" and t.exists()]

    broken = []
    for md in targets:
        for lineno, raw in links_in(md):
            kind, resolved = classify(md, raw)
            if kind != "internal":
                continue
            rel = resolved.relative_to(REPO_ROOT).as_posix()
            if rel not in files and rel not in dirs:
                note = (" (exists on disk but is not part of the corpus — broken for"
                        " everyone else)" if resolved.exists() else "")
                broken.append((md.relative_to(REPO_ROOT), lineno, raw, note))

    for rel, lineno, raw, note in broken:
        print(f"{rel}:{lineno}: broken link -> {raw}{note}")

    bad_names = [] if args else [
        f for f in all_md
        if not any(p.match(Path(f).name) for p in NAME_PATTERNS)]
    for f in bad_names:
        print(f"{f}: filename is not kebab-case")

    print(f"\nChecked {len(targets)} file(s).")
    if broken or bad_names:
        print(f"FAIL: {len(broken)} broken link(s), {len(bad_names)} naming violation(s).")
        return 1
    print("OK: every link resolves and every filename is kebab-case.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
