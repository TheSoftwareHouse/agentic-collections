{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*([Aa]tlassian|[Jj]ira|[Rr]ovo|[Cc]onfluence).*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard-jira-write.mjs"]
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(**/CLAUDE.md)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard-project-context-block.mjs"]
          },
          {
            "type": "command",
            "if": "Write(**/CLAUDE.md)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard-project-context-block.mjs"]
          },
          {
            "type": "command",
            "if": "Edit(**/CLAUDE.local.md)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard-project-context-block.mjs"]
          },
          {
            "type": "command",
            "if": "Write(**/CLAUDE.local.md)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/guard-project-context-block.mjs"]
          }
        ]
      }
    ]
  }
}
